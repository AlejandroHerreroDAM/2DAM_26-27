<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controlador.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Panel de Gestión de Tareas" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <TableView fx:id="tablaTareas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                    <TableColumn fx:id="colResponsable" prefWidth="150.0" text="Responsable" />
                    <TableColumn fx:id="colPorcentaje" prefWidth="110.0" text="Avance (%)" />
                    <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
                    <TableColumn fx:id="colUbicacion" prefWidth="150.0" text="Ubicación" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <Button onAction="#onCrearClick" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Nueva Tarea" />
            <Button onAction="#onModificarClick" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Modificar Tarea" />
            <Separator orientation="VERTICAL" />
            <Button onAction="#onEstadisticasClick" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Ver Estadísticas" />
            <Button onAction="#onInformeClick" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Generar Informe" />
        </HBox>
    </bottom>
</BorderPane>